# ctest helper: `<app binary> list` must show exactly the app's tools plus app.*,
# and `--version`, `help` and a handoff command must work.
string(REPLACE "," ";" expected "${TOOLS}")
list(APPEND expected app)
execute_process(COMMAND ${BIN} list OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "${BIN} list failed (${rc})")
endif()
string(REGEX MATCHALL "\n  [a-z_]+\\.[a-z_0-9]+" ids "\n${out}")
set(seen "")
foreach(id IN LISTS ids)
  string(STRIP "${id}" id)
  string(REGEX REPLACE "\\..*" "" tool "${id}")
  list(APPEND seen ${tool})
endforeach()
list(REMOVE_DUPLICATES seen)
list(SORT seen)
list(SORT expected)
if(NOT seen STREQUAL expected)
  message(FATAL_ERROR "${BIN} lists tools '${seen}', expected '${expected}'")
endif()
foreach(args "--version" "help;app.send" "app.open_with;path=x.png")
  execute_process(COMMAND ${BIN} ${args} OUTPUT_VARIABLE o ERROR_VARIABLE e RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${BIN} ${args} failed (${rc}): ${o}${e}")
  endif()
endforeach()
message(STATUS "${BIN}: ${seen}")
