# libwebp (BSD-3-Clause) for reading and writing .webp in libs/raster. Downloaded once into
# the build folder; without it (offline, or -DWETWARESUITE_WEBP=OFF) everything else still builds
# and .webp files are reported as unsupported. Defines the target wetwaresuite_webp when available.
option(WETWARESUITE_WEBP "Read and write WebP images (downloads libwebp)" ON)
set(WETWARESUITE_WEBP_VERSION 1.5.0)
set(WETWARESUITE_WEBP_SHA256 7d6fab70cf844bf6769077bd5d7a74893f8ffd4dfb42861745750c63c2a5c92c)
set(WETWARESUITE_WEBP_URL
    https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-${WETWARESUITE_WEBP_VERSION}.tar.gz)

if(WETWARESUITE_WEBP AND NOT TARGET wetwaresuite_webp)
  set(_ww_webp_archive ${CMAKE_BINARY_DIR}/_deps/libwebp-${WETWARESUITE_WEBP_VERSION}.tar.gz)
  set(_ww_webp_source OFF)
  if(FETCHCONTENT_SOURCE_DIR_LIBWEBP)
    set(_ww_webp_source ON)
  else()
    if(NOT EXISTS ${_ww_webp_archive})
      message(STATUS "raster: downloading libwebp ${WETWARESUITE_WEBP_VERSION}")
      # no EXPECTED_HASH here: a failed download would then stop the whole configure
      file(DOWNLOAD ${WETWARESUITE_WEBP_URL} ${_ww_webp_archive}.part TLS_VERIFY ON STATUS _ww_status)
      list(GET _ww_status 0 _ww_code)
      list(GET _ww_status 1 _ww_reason)
      if(_ww_code EQUAL 0)
        file(SHA256 ${_ww_webp_archive}.part _ww_hash)
        if(NOT _ww_hash STREQUAL WETWARESUITE_WEBP_SHA256)
          set(_ww_code 1)
          set(_ww_reason "wrong SHA-256 ${_ww_hash}")
        endif()
      endif()
      if(_ww_code EQUAL 0)
        file(RENAME ${_ww_webp_archive}.part ${_ww_webp_archive})
      else()
        file(REMOVE ${_ww_webp_archive}.part)
        message(WARNING "raster: couldn't download libwebp (${_ww_reason}); building without WebP. "
                        "Set FETCHCONTENT_SOURCE_DIR_LIBWEBP to a libwebp source folder, or -DWETWARESUITE_WEBP=OFF.")
      endif()
    endif()
    if(EXISTS ${_ww_webp_archive})
      set(_ww_webp_source ON)
    endif()
  endif()

  if(_ww_webp_source)
    # just the library: no command-line tools, no shared build
    set(WEBP_BUILD_ANIM_UTILS OFF CACHE BOOL "" FORCE)
    set(WEBP_BUILD_CWEBP OFF CACHE BOOL "" FORCE)
    set(WEBP_BUILD_DWEBP OFF CACHE BOOL "" FORCE)
    set(WEBP_BUILD_GIF2WEBP OFF CACHE BOOL "" FORCE)
    set(WEBP_BUILD_IMG2WEBP OFF CACHE BOOL "" FORCE)
    set(WEBP_BUILD_VWEBP OFF CACHE BOOL "" FORCE)
    set(WEBP_BUILD_WEBPINFO OFF CACHE BOOL "" FORCE)
    set(WEBP_BUILD_WEBPMUX OFF CACHE BOOL "" FORCE)
    set(WEBP_BUILD_EXTRAS OFF CACHE BOOL "" FORCE)
    set(WEBP_BUILD_LIBWEBPMUX OFF CACHE BOOL "" FORCE)
    set(WEBP_BUILD_WEBP_JS OFF CACHE BOOL "" FORCE)
    set(WEBP_BUILD_FUZZTEST OFF CACHE BOOL "" FORCE)
    set(WEBP_USE_THREAD OFF CACHE BOOL "" FORCE)
    set(WEBP_NEAR_LOSSLESS ON CACHE BOOL "" FORCE)
    set(_ww_shared ${BUILD_SHARED_LIBS})
    set(BUILD_SHARED_LIBS OFF)
    # libwebp is C with its own warning settings: don't hand it ours
    set(_ww_opts "")
    get_directory_property(_ww_opts COMPILE_OPTIONS)
    set_property(DIRECTORY PROPERTY COMPILE_OPTIONS "")
    set(_ww_exclude "")
    if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.28)
      set(_ww_exclude EXCLUDE_FROM_ALL)  # only what we link gets built
    endif()
    FetchContent_Declare(libwebp URL ${_ww_webp_archive} URL_HASH SHA256=${WETWARESUITE_WEBP_SHA256} DOWNLOAD_EXTRACT_TIMESTAMP TRUE
                         ${_ww_exclude})
    FetchContent_MakeAvailable(libwebp)
    set_property(DIRECTORY PROPERTY COMPILE_OPTIONS "${_ww_opts}")
    set(BUILD_SHARED_LIBS ${_ww_shared})
    if(TARGET webp)
      add_library(wetwaresuite_webp INTERFACE)
      target_link_libraries(wetwaresuite_webp INTERFACE webp)
      target_include_directories(wetwaresuite_webp INTERFACE ${libwebp_SOURCE_DIR}/src)
      message(STATUS "raster: WebP support from libwebp ${WETWARESUITE_WEBP_VERSION}")
    endif()
  endif()
endif()
